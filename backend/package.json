{
  "name": "backend",
  "version": "1.0.0",
  "description": "Resume builder API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "compiler": "tsx watch src/compiler-server.ts",
    "start:compiler": "node dist/compiler-server.js",
    "worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "openapi": "tsx --env-file-if-exists=.env src/scripts/write-openapi.ts",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@ai-sdk/openai": "^4.0.75",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@ip-location-db/dbip-country-mmdb": "2.3.2026060120",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.114",
    "better-auth": "^1.7.6",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "maxmind": "5.0.7",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.54.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "private": true
}
