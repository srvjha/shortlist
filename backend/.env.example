NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resumebuilder
# Rate limit counters; required in production
LOG_LEVEL=info
# Production: https://shortlist.co.in
FRONTEND_URL=http://localhost:3000

# AI: pick openai, anthropic or openrouter and set that provider's key.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Encrypts API keys that users add in Settings (bring your own key). Generate with:
# openssl rand -hex 32. Keep it stable: changing it makes saved user keys unreadable.
# Empty: derived from BETTER_AUTH_SECRET.
AI_KEY_ENCRYPTION_SECRET=
# Optional model overrides; defaults depend on the provider.
AI_MODEL_FAST=
AI_MODEL_SMART=

# Auth (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Production: https://api.shortlist.co.in
BETTER_AUTH_URL=http://localhost:4000
# Production only: .shortlist.co.in, so the app and api.shortlist.co.in share the session cookie.
COOKIE_DOMAIN=
# Production: the same value as PROXY_SECRET on the frontend (Vercel). Generate with: openssl rand -hex 32.
# Empty: share and profile page visitors all share one rate limit.
PROXY_SECRET=
# One-click guest accounts (deleted after 7 days). Unset: on in development, off in production.
ENABLE_GUEST_LOGIN=
# Sign-in providers. Google, GitHub and ChatGPT are the only ways to sign in.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google, /api/auth/callback/github
# and /api/auth/callback/chatgpt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "Sign in with ChatGPT": partner access only for now. Apply at https://openai.com/form/sign-in-with-chatgpt-interest/
# OpenAI issues a client ID (oaiapp_...) and, for a confidential client, a secret; leave the secret empty for a public client.
# Register the redirect URL <BETTER_AUTH_URL>/api/auth/callback/chatgpt with them. Leave the discovery URL empty.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_DISCOVERY_URL=

# File storage for PDFs, uploads and backups. "local" writes to LOCAL_STORAGE_DIR.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Cloudflare R2 (S3-compatible), used when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LaTeX compiler (Tectonic). In production set COMPILER_URL to the separate compiler
# service (e.g. http://compiler:4100). Unset in development compiles in-process.
COMPILER_URL=
TECTONIC_BIN=tectonic
TECTONIC_ONLY_CACHED=false
COMPILE_TIMEOUT_MS=20000
COMPILE_CONCURRENCY=2

# Job post fetching from URLs via Jina Reader (works without a key at a lower rate limit)
JINA_API_KEY=

# PostHog (Settings > Project > General): the public project token and your region's host.
# Only product events and API timings are sent, never resume content or emails. Empty: nothing is sent.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Admin dashboard's traffic page reads PostHog back. Create a personal API key at
# PostHog > Settings > Personal API keys with the scopes query:read and session_recording:read.
# The project ID is the number in your PostHog URL (/project/<id>). App host: https://us.posthog.com or https://eu.posthog.com.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://us.posthog.com

# Emails allowed into the admin dashboard (/admin), comma-separated. The sign-in provider must have verified them.
ADMIN_EMAILS=

# Payments (Razorpay). Webhook URL: <BETTER_AUTH_URL>/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed, subscription.activated,
# subscription.charged, subscription.cancelled, subscription.completed, subscription.halted
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
# Set RAZORPAY_MODE=test to use these Test Mode values instead of the live ones above; switch back with live.
# Test keys, plans and webhooks are separate from live ones in the Razorpay dashboard (toggle Test Mode).
RAZORPAY_MODE=live
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_TEST_PRO_PLAN_ID=

# Polar (polar.sh) takes payments from visitors outside India, as merchant of record. Use sandbox.polar.sh while
# testing; production (polar.sh) has separate tokens, products and webhooks.
# Token: Settings > General > Developers > New token (scopes checkouts:write, orders:read, refunds:read, refunds:write).
# Products: Products > New product, one-time (no billing cycle), priced in USD: "Season Pass" ($9) and "Pro, 1 month"
# ($4). Copy each product's ID. Webhook: Settings > Webhooks > Add endpoint, URL https://<api>/v1/webhooks/polar,
# format Raw, events order.paid, order.refunded and checkout.updated; copy its secret.
# Who takes payments from India: razorpay, or polar (then add INR prices, ₹499 and ₹129, to both Polar products).
PAYMENTS_INDIA=razorpay
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SEASON_PASS_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# Production only (docker-compose.prod.yml reads these from .env.production)
POSTGRES_PASSWORD=
# Encrypts nightly database backups. Generate with: openssl rand -hex 32. Store a copy outside the server.
BACKUP_ENCRYPTION_KEY=
# Seconds between database backups; empty means once a day.
BACKUP_INTERVAL_SECONDS=
